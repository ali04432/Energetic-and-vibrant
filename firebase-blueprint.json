{
  "entities": {
    "UserStats": {
      "title": "UserStats",
      "description": "Per-user study streak counters, daily focus goal, and profile summary.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID owning this record."
        },
        "displayName": {
          "type": "string",
          "description": "User display name shown on dashboard."
        },
        "currentStreak": {
          "type": "integer",
          "description": "Active consecutive study days."
        },
        "longestStreak": {
          "type": "integer",
          "description": "Highest consecutive study days achieved."
        },
        "lastFocusDate": {
          "type": "string",
          "description": "ISO local date (YYYY-MM-DD) of the most recent completed focus session, or empty string."
        },
        "dailyGoalMinutes": {
          "type": "integer",
          "description": "Target daily focus duration in minutes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "displayName",
        "currentStreak",
        "longestStreak",
        "lastFocusDate",
        "dailyGoalMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic course or study subject with color badge and instructor metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "instructor": { "type": "string" },
        "colorHex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "code", "instructor", "colorHex", "createdAt", "updatedAt"]
    },
    "TimetableSlot": {
      "title": "TimetableSlot",
      "description": "Weekly recurring class or study block assigned to a day of week.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "colorHex": { "type": "integer" },
        "dayOfWeek": { "type": "integer" },
        "startMinutes": { "type": "integer" },
        "endMinutes": { "type": "integer" },
        "room": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "subjectId",
        "subjectName",
        "colorHex",
        "dayOfWeek",
        "startMinutes",
        "endMinutes",
        "room",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Assignment or exam with due timestamp, priority, and notification lead time.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "colorHex": { "type": "integer" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "type": { "type": "string", "enum": ["EXAM", "ASSIGNMENT", "READING", "PROJECT", "LAB"] },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "dueAtMillis": { "type": "integer" },
        "reminderLeadMinutes": { "type": "integer" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "subjectId",
        "subjectName",
        "colorHex",
        "title",
        "notes",
        "type",
        "priority",
        "dueAtMillis",
        "reminderLeadMinutes",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "Completed Pomodoro focus sprint logged for weekly analytics and streak calculation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "taskId": { "type": "string" },
        "taskType": { "type": "string", "enum": ["EXAM", "ASSIGNMENT", "READING", "PROJECT", "LAB"] },
        "durationMinutes": { "type": "integer" },
        "dateKey": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "subjectId",
        "subjectName",
        "taskId",
        "taskType",
        "durationMinutes",
        "dateKey",
        "completedAt"
      ]
    },
    "StudySpot": {
      "title": "StudySpot",
      "description": "Campus classroom, library, quiet cafe, or exam hall pinned on Google Maps.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["CLASSROOM", "LIBRARY", "CAFE", "EXAM_HALL"] },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "subjectId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "category",
        "address",
        "notes",
        "subjectId",
        "latitude",
        "longitude",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Multi-turn Gemini Study Coach conversation thread with selected persona and grounding toggle.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "persona": { "type": "string", "enum": ["STUDY_TUTOR", "EXAM_COACH", "DEEP_SOLVER"] },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "useSearchGrounding": { "type": "boolean" },
        "lastMessagePreview": { "type": "string" },
        "messageCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title",
        "persona",
        "subjectId",
        "subjectName",
        "useSearchGrounding",
        "lastMessagePreview",
        "messageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessageRecord": {
      "title": "ChatMessageRecord",
      "description": "Single user or Gemini turn inside a Study Coach thread with optional Search Grounding citations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "threadId": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "persona": { "type": "string", "enum": ["STUDY_TUTOR", "EXAM_COACH", "DEEP_SOLVER"] },
        "modelUsed": { "type": "string" },
        "webSearchUsed": { "type": "boolean" },
        "sourcesJson": { "type": "string" },
        "sequenceIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "threadId",
        "senderRole",
        "text",
        "persona",
        "modelUsed",
        "webSearchUsed",
        "sourcesJson",
        "sequenceIndex",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserStats" },
      "description": "Authenticated user profile and streak metadata."
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "User's academic subjects."
    },
    "/users/{userId}/slots/{slotId}": {
      "schema": { "$ref": "#/entities/TimetableSlot" },
      "description": "User's weekly class timetable slots."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/StudyTask" },
      "description": "User's assignments and exam deadlines."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FocusSession" },
      "description": "User's completed Pomodoro focus sessions."
    },
    "/users/{userId}/spots/{spotId}": {
      "schema": { "$ref": "#/entities/StudySpot" },
      "description": "User's pinned campus classes and study spots."
    },
    "/users/{userId}/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "User's multi-turn Study Coach conversation threads."
    },
    "/users/{userId}/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessageRecord" },
      "description": "Ordered user and model messages within a Study Coach thread."
    }
  }
}
