rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserStats(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() <= 80 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 10000 &&
             data.lastFocusDate is string && (data.lastFocusDate == '' || data.lastFocusDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
             data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 10 && data.dailyGoalMinutes <= 720 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.code is string && data.code.size() <= 20 &&
             data.instructor is string && data.instructor.size() <= 60 &&
             data.colorHex is int &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTimetableSlot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 60 &&
             data.colorHex is int &&
             data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7 &&
             data.startMinutes is int && data.startMinutes >= 0 && data.startMinutes <= 1439 &&
             data.endMinutes is int && data.endMinutes > data.startMinutes && data.endMinutes <= 1440 &&
             data.room is string && data.room.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyTask(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.subjectName is string && data.subjectName.size() <= 60 &&
             data.colorHex is int &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.type is string && (data.type == 'EXAM' || data.type == 'ASSIGNMENT' || data.type == 'READING' || data.type == 'PROJECT' || data.type == 'LAB') &&
             data.priority is string && (data.priority == 'LOW' || data.priority == 'MEDIUM' || data.priority == 'HIGH') &&
             data.dueAtMillis is int && data.dueAtMillis > 0 &&
             data.reminderLeadMinutes is int && data.reminderLeadMinutes >= 0 && data.reminderLeadMinutes <= 10080 &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFocusSession(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.subjectName is string && data.subjectName.size() <= 60 &&
             data.taskId is string && data.taskId.size() <= 128 &&
             data.taskType is string && (data.taskType == 'EXAM' || data.taskType == 'ASSIGNMENT' || data.taskType == 'READING' || data.taskType == 'PROJECT' || data.taskType == 'LAB') &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 240 &&
             data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.completedAt is timestamp && data.completedAt <= request.time;
    }

    function isValidStudySpot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.category is string && (data.category == 'CLASSROOM' || data.category == 'LIBRARY' || data.category == 'CAFE' || data.category == 'EXAM_HALL') &&
             data.address is string && data.address.size() <= 200 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatPersona(persona) {
      return persona is string && (persona == 'STUDY_TUTOR' || persona == 'EXAM_COACH' || persona == 'DEEP_SOLVER');
    }

    function isValidChatThread(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             isValidChatPersona(data.persona) &&
             data.subjectId is string && data.subjectId.size() <= 128 &&
             data.subjectName is string && data.subjectName.size() <= 60 &&
             data.useSearchGrounding is bool &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId, threadId) {
      return data.userId is string && data.userId == userId &&
             data.threadId is string && data.threadId == threadId &&
             data.senderRole is string && (data.senderRole == 'user' || data.senderRole == 'model') &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 12000 &&
             isValidChatPersona(data.persona) &&
             data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 60 &&
             data.webSearchUsed is bool &&
             data.sourcesJson is string && data.sourcesJson.size() <= 8000 &&
             data.sequenceIndex is int && data.sequenceIndex >= 0 && data.sequenceIndex <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'currentStreak', 'longestStreak', 'lastFocusDate', 'dailyGoalMinutes', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'currentStreak', 'longestStreak', 'lastFocusDate', 'dailyGoalMinutes', 'createdAt', 'updatedAt']) &&
                       isValidUserStats(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserStats(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currentStreak', 'longestStreak', 'lastFocusDate', 'dailyGoalMinutes', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         incoming().keys().hasAll(['userId', 'name', 'code', 'instructor', 'colorHex', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'code', 'instructor', 'colorHex', 'createdAt', 'updatedAt']) &&
                         isValidSubject(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         isValidSubject(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'instructor', 'colorHex', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /slots/{slotId} {
        allow get: if isOwner(userId) && isValidId(slotId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(slotId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'subjectName', 'colorHex', 'dayOfWeek', 'startMinutes', 'endMinutes', 'room', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'subjectName', 'colorHex', 'dayOfWeek', 'startMinutes', 'endMinutes', 'room', 'createdAt', 'updatedAt']) &&
                         isValidTimetableSlot(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(slotId) &&
                         isValidTimetableSlot(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['subjectId', 'subjectName', 'colorHex', 'dayOfWeek', 'startMinutes', 'endMinutes', 'room', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(slotId);
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'subjectName', 'colorHex', 'title', 'notes', 'type', 'priority', 'dueAtMillis', 'reminderLeadMinutes', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'subjectName', 'colorHex', 'title', 'notes', 'type', 'priority', 'dueAtMillis', 'reminderLeadMinutes', 'completed', 'createdAt', 'updatedAt']) &&
                         isValidStudyTask(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['subjectId', 'subjectName', 'colorHex', 'title', 'notes', 'type', 'priority', 'dueAtMillis', 'reminderLeadMinutes', 'completed', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'subjectName', 'taskId', 'taskType', 'durationMinutes', 'dateKey', 'completedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'subjectName', 'taskId', 'taskType', 'durationMinutes', 'dateKey', 'completedAt']) &&
                         isValidFocusSession(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /spots/{spotId} {
        allow get: if isOwner(userId) && isValidId(spotId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(spotId) &&
                         incoming().keys().hasAll(['userId', 'name', 'category', 'address', 'notes', 'subjectId', 'latitude', 'longitude', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'category', 'address', 'notes', 'subjectId', 'latitude', 'longitude', 'createdAt', 'updatedAt']) &&
                         isValidStudySpot(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(spotId) &&
                         isValidStudySpot(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'address', 'notes', 'subjectId', 'latitude', 'longitude', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(spotId);
      }

      match /chatThreads/{threadId} {
        allow get: if isOwner(userId) && isValidId(threadId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(threadId) &&
                         incoming().keys().hasAll(['userId', 'title', 'persona', 'subjectId', 'subjectName', 'useSearchGrounding', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'persona', 'subjectId', 'subjectName', 'useSearchGrounding', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         isValidChatThread(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(threadId) &&
                         isValidChatThread(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'persona', 'subjectId', 'subjectName', 'useSearchGrounding', 'lastMessagePreview', 'messageCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(threadId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(threadId);

          allow create: if isOwner(userId) &&
                           isValidId(threadId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['userId', 'threadId', 'senderRole', 'text', 'persona', 'modelUsed', 'webSearchUsed', 'sourcesJson', 'sequenceIndex', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'threadId', 'senderRole', 'text', 'persona', 'modelUsed', 'webSearchUsed', 'sourcesJson', 'sequenceIndex', 'createdAt']) &&
                           isValidChatMessage(incoming(), userId, threadId);

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(threadId) && isValidId(messageId);
        }
      }
    }
  }
}
